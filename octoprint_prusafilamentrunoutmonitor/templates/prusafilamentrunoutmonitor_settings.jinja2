<h4>Prusa Filament Runout <small>{{ _('Version') }} {{ plugin_prusafilamentrunoutmonitor_plugin_version }}</small></h4>

<p><strong>{{ _('How to set parked X/Y:') }}</strong>
{{ _('Start a sacrificial print and cut the filament while watching Terminal in OctoPrint. You should see lines like:') }}
</p>
<pre>echo:busy: processing
X:241.00 Y:-3.00 Z:38.90 E:89.28 Count X:24099 Y:-300 Z:15559</pre>
<p>
{{ _('Use the X and Y values from the second line (e.g.') }} <code>241.00</code> {{ _('and') }} <code>-3.00</code>{{ _(').') }}
<br><strong>{{ _('Important:') }}</strong> {{ _('enter the full numeric strings exactly as reported (e.g. enter') }} <code>241.00</code>{{ _(', not') }} <code>241</code>{{ _(').') }}
</p>

<p>
  {{ _('Note: Prusa firmware changed the default park location in a later release; it is now X=42.00, Y=-7.00 instead of X=241.00, Y=-3.00. Always copy the exact values shown in Terminal for your printer/firmware. This plugin has been updated to use the new values, but they may change in the future.') }}
</p>

<form class="form-vertical" id="settings_plugin_prusafilamentrunoutmonitor_form">
    <div class="row-fluid">
        <div class="control-group span4" id="pfrm_x_position">
            <label class="control-label">{{ _('X Position') }}</label>
            <div class="controls">
                <input type="text" value="">
            </div>
        </div>
        <div class="control-group span4" id="pfrm_y_position">
            <label class="control-label">{{ _('Y Position') }}</label>
            <div class="controls">
                <input type="text" value="">
            </div>
        </div>
        <div class="control-group span4">
            <label class="control-label">{{ _('Actions') }}</label>
            <div class="controls btn-group">
                <button class="btn btn-primary" data-bind="click: add_position"><i class="fas fa-plus"></i></button>
            </div>
        </div>
    </div>

    <div class="row-fluid">
        <div class="span4" data-bind="foreach: settingsViewModel.settings.plugins.prusafilamentrunoutmonitor.x_positions">
            <div class="row-fluid">
                <span class="input-block-level" data-bind="text: $data"></span>
            </div>
        </div>
        <div class="span4" data-bind="foreach: settingsViewModel.settings.plugins.prusafilamentrunoutmonitor.y_positions">
            <div class="row-fluid">
                <span class="input-block-level" data-bind="text: $data"></span>
            </div>
        </div>
        <div class="span4" data-bind="foreach: settingsViewModel.settings.plugins.prusafilamentrunoutmonitor.x_positions">
            <div class="row-fluid">
                <button class="btn btn-danger" data-bind="click: function() {$root.remove_position($index())}"><i class="fas fa-trash-alt"></i></button>
            </div>
        </div>
    </div>
</form>
